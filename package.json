{
  "name": "kora-support-triage",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "backend/.venv/bin/uvicorn app.main:app --app-dir backend --reload --port 8000",
    "backend:setup": "python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements-dev.txt",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "PYTHONPATH=backend backend/.venv/bin/pytest -q backend/tests",
    "evaluate": "PYTHONPATH=backend backend/.venv/bin/python -m app.run_evaluation --output backend/data/evaluation-report.json",
    "evaluate:smoke": "PYTHONPATH=backend backend/.venv/bin/python -m app.run_evaluation --smoke --output evidence/live-smoke-report.json",
    "test:frontend": "vitest run",
    "lint": "eslint src && npm run lint:backend",
    "lint:backend": "backend/.venv/bin/ruff check backend"
  },
  "dependencies": {
    "@fontsource-variable/elms-sans": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.4",
    "vitest": "^5.0.1"
  }
}
