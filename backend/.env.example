# Copy this file to .env and add your real key. Never commit .env.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b
KORA_DATABASE_PATH=data/kora.db
KORA_ALLOWED_ORIGINS=http://localhost:4173
KORA_MANUAL_BASELINE_MINUTES=12

# Authentication and tenancy. Keep demo mode for the public portfolio build.
# With KORA_AUTH_MODE=required, issue tokens with `python -m app.manage create-token`.
KORA_AUTH_MODE=demo
KORA_DEFAULT_TENANT_ID=tenant-demo
# Seed the 18 synthetic demo cases. Defaults to true only in demo auth mode.
# KORA_SEED_DEMO_DATA=true

# Abuse protection. Set KORA_TRUST_PROXY_HEADERS=true behind Railway or another
# proxy so limits apply to the real client IP.
KORA_TRUST_PROXY_HEADERS=false
KORA_AI_REQUESTS_PER_MINUTE=10
KORA_WRITE_REQUESTS_PER_MINUTE=60
# Demo mode only: shared daily model-call budget and proof-run size.
KORA_DEMO_DAILY_AI_LIMIT=300
KORA_DEMO_PROOF_CASE_LIMIT=12
KORA_PROOF_CONCURRENCY=4

# Protect the provider-neutral webhook with this shared secret. Webhooks are
# refused without it; KORA_ALLOW_UNSIGNED_WEBHOOKS=true is for local testing only.
KORA_WEBHOOK_TOKEN=replace-with-a-long-random-value
# KORA_ALLOW_UNSIGNED_WEBHOOKS=false

# demo records sends in SQLite without contacting customers; live enables providers.
KORA_CHANNEL_MODE=demo
KORA_WORKER_ENABLED=true
KORA_WORKER_POLL_SECONDS=1.5
# Jobs left "running" this long (e.g. after a redeploy) are retried.
KORA_JOB_LEASE_SECONDS=300

# Route inbound traffic to tenants: "address:tenant,..." and "phone_number_id:tenant,...".
# Unmapped traffic goes to KORA_DEFAULT_TENANT_ID.
KORA_EMAIL_TENANTS=
KORA_WHATSAPP_TENANTS=

# Email delivery with Postmark.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Postmark supports HTTP basic authentication in webhook URLs. Configure both,
# then register https://USERNAME:PASSWORD@your-host/api/webhooks/postmark/inbound
# and the matching /delivery URL in Postmark.
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=

# WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Optional read-only transaction verification.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
