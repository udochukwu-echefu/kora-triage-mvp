# Copy this file to .env and add your real key. Never commit .env.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b
KORA_DATABASE_PATH=data/kora.db
KORA_ALLOWED_ORIGINS=http://localhost:4173
KORA_MANUAL_BASELINE_MINUTES=12

# Authentication and tenancy. Keep demo mode for the public portfolio build.
KORA_AUTH_MODE=demo
KORA_DEFAULT_TENANT_ID=tenant-demo

# Protect the provider-neutral webhook with this shared secret.
KORA_WEBHOOK_TOKEN=replace-with-a-long-random-value

# demo records sends in SQLite without contacting customers; live enables providers.
KORA_CHANNEL_MODE=demo
KORA_WORKER_ENABLED=true
KORA_WORKER_POLL_SECONDS=1.5

# Email delivery with Postmark.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Postmark supports HTTP basic authentication in webhook URLs. Configure both,
# then register https://USERNAME:PASSWORD@your-host/api/webhooks/postmark/inbound
# and the matching /delivery URL in Postmark.
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=

# WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Optional read-only transaction verification.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
